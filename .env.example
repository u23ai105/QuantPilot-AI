APP_ENV=development
APP_NAME=QuantPilot AI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quantpilot
# Also backs the rate limiter and the RAG query-embedding cache; both fail open if it is unreachable.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JWT_SECRET=your_jwt_secret_here
LOG_LEVEL=INFO

# Security & CORS
# Comma-separated list of allowed origins (e.g., https://your-frontend.onrender.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-caller rate limiting (Redis-backed, see app/core/rate_limit.py). Set false to disable;
# the limits themselves live in DEFAULT_RULES in app/api/middleware/rate_limit.py.
RATE_LIMIT_ENABLED=true

# Bearer token required to scrape GET /metrics. Leave empty for an open endpoint, which is what a
# Prometheus on a private network expects; set it whenever the API port is reachable from outside.
METRICS_TOKEN=

# Frontend (for Vite build)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Gemini AI (Phase 4)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
